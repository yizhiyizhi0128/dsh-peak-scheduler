{
  "name": "dsh-peak-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：自动查询 DeepSeek 峰谷价格时段；在输入框加「峰谷调度」按钮，点击后可选立即执行或推迟到谷价时段；推迟的任务落到官方 schedule 服务，侧边栏显示等待数与列表，并可随时手动改为立即开始。",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "peak",
    "off-peak",
    "pricing",
    "scheduler"
  ],
  "author": "一直一直 <20906576@qq.com>",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "src",
    "test",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
